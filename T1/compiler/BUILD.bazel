load("//bazel:api.bzl", "modular_cc_binary")

package(default_visibility = ["//visibility:public"])

modular_cc_binary(
    name = "libT1Compiler.so",
    srcs = [
        "T1Backend.cpp",
        "T1Backend.h",
        "T1Traits.cpp",
        "T1Traits.h",
        "t1_builtins.inc",
    ],
    linkshared = True,
    deps = [
        "//Mojo:HostBackend",
        "//Mojo:TargetBackend.headers",
        "//Mojo:TargetTraits",
        "//Mojo:ToolCommon.headers",
        "//Support:Buffer",
        "//Support:Filesystem",
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:Support",
        "@llvm-project//llvm:TargetParser",
        "@llvm-project//mlir:IR",
    ],
)
