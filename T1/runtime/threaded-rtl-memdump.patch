diff --git a/difftest/dpi_t1rocketemu/src/addrspace.rs b/difftest/dpi_t1rocketemu/src/addrspace.rs
index 33d4828d..c1b4f6ab 100644
--- a/difftest/dpi_t1rocketemu/src/addrspace.rs
+++ b/difftest/dpi_t1rocketemu/src/addrspace.rs
@@ -66,0 +67,9 @@ impl AddressSpace {
+  pub fn dump_range(&mut self, addr: u32, len: u32, path: &Path) {
+    assert!(len > 0 && addr.checked_add(len).is_some(), "invalid memory dump range");
+    let device_idx = self.find_device_idx(addr, len).expect("memory dump outside device RAM");
+    let entry = &mut self.devices[device_idx];
+    let offset = (addr - entry.base_and_size.0) as usize;
+    let ram = entry.device.as_ram_mut().expect("memory dump requires a RAM device");
+    std::fs::write(path, &ram[offset..offset + len as usize]).expect("memory dump write failed");
+  }
+
