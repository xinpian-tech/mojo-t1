@@ -314 +314 @@ unsafe extern "C" fn t1_cosim_final(target: *mut Target) {
-  let Ok(driver) = target.into_inner() else {
+  let Ok(mut driver) = target.into_inner() else {
@@ -319,0 +320,11 @@ unsafe extern "C" fn t1_cosim_final(target: *mut Target) {
+  if success {
+    let arguments = dpi_common::plusarg::PlusArgMatcher::from_args();
+    if let Some(path) = arguments.try_match("t1_memory_dump_path") {
+      let range = arguments.match_("t1_memory_dump_range");
+      let (start, end) = range.split_once(':').expect("memory dump range must be START:END");
+      let start = u32::from_str_radix(start.trim_start_matches("0x"), 16).expect("invalid dump start");
+      let end = u32::from_str_radix(end.trim_start_matches("0x"), 16).expect("invalid dump end");
+      assert!(end > start, "empty or reversed memory dump range");
+      driver.addr_space.dump_range(start, end - start, std::path::Path::new(path));
+    }
+  }
